# Paperclip Configuration
PAPERCLIP_PUBLIC_URL=http://localhost:3100
PAPERCLIP_EMAIL=your-email@example.com
PAPERCLIP_PASSWORD=your-secure-password

# AI Wizard Mode (Optional)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# Development Configuration
NODE_ENV=development

# Plugin Configuration (Optional)
# Override default template directory
# TEMPLATES_PATH=/path/to/templates

# Override default companies directory
# COMPANIES_DIR=/path/to/companies

# Custom templates repository (GitHub tree URL)
# TEMPLATES_REPO_URL=https://api.github.com/repos/username/repo/git/trees/main

# Paperclip Instance URL (if not default)
# PAPERCLIP_URL=http://localhost:3100

# Development Server Port
# DEV_SERVER_PORT=4177

# Enable verbose logging
# VERBOSE=true

# Docker-specific (for Docker Compose)
# These are set in docker-compose.yml but can be overridden
# DOCKER_NODE_ENV=development
